# Optional Codex data directory. Defaults to ~/.codex
# CODEX_HOME=C:\Users\you\.codex

# Local server port. Use 0 for a random available port.
TOKEN_LENS_PORT=4173

# Optional cache directory.
# TOKEN_LENS_CACHE_DIR=C:\Users\you\AppData\Local\Temp\codex-token-lens

# Optional custom pricing JSON.
# TOKEN_LENS_PRICES_JSON={"models":[{"pattern":"gpt-5.6-luna","label":"GPT-5.6 Luna","input":1,"cachedInput":0.1,"cacheWriteInput":1.25,"output":6}]}

# Optional path to a pricing JSON file.
# TOKEN_LENS_PRICING_FILE=C:\path\to\pricing.json

# Incremental scan cache lifetime. Use 0 to force a full scan every request.
# TOKEN_LENS_CACHE_TTL=15m

# Maximum number of session files parsed concurrently.
# TOKEN_LENS_SCAN_CONCURRENCY=3

# Optional local API protection. The browser also accepts ?token=... once and stores it for the session.
# TOKEN_LENS_API_TOKEN=change-me

# Optional browser alert thresholds.
# TOKEN_LENS_DAILY_COST_ALERT_USD=1
# TOKEN_LENS_RATE_LIMIT_ALERT_PERCENT=10
